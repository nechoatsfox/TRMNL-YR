# TRMNL Configuration
TRMNL_WEBHOOK_URL=https://usetrmnl.com/api/custom_plugins/XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# Location Configuration (use max 4 decimals)
LOCATION_LAT=59.9139

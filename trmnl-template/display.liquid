<!DOCTYPE html>
<html>
<head>
  <link rel="stylesheet" href="https://usetrmnl.com/css/latest/plugins.css">
  <script src="https://usetrmnl.com/js/latest/plugins.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
  <style>
    .layout {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 30px 20px 20px 20px;
      font-family: 'Inter', Arial, sans-serif;
    }

    .weather-icon {
      font-size: 200px;
      line-height: 0.8;
      margin-bottom: 20px;
    }

    .current-temp {
      font-size: 100px;
      font-weight: 700;
      line-height: 1;
      margin-bottom: 30px;
    }

    .columns {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      width: 100%;
      max-width: 650px;
    }

    .column {
      text-align: left;
    }

    .condition-text {
      font-size: 24px;
      font-weight: 600;
      margin-bottom: 8px;
      line-height: 1.2;
    }

    .temp-text {
      font-size: 20px;
      font-weight: 400;
      margin-bottom: 6px;
    }

    .uv-text {
      font-size: 18px;
      font-weight: 400;
    }

    .tomorrow-badge {
      background: #000;
      color: #fff;
      padding: 5px 12px;
      font-size: 18px;
      font-weight: 700;
      display: inline-block;
      margin-bottom: 10px;
    }

    .title_bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      padding: 0 20px 20px 20px;
    }

    .title_bar .time {
      font-size: 22px;
      font-weight: 600;
    }

    .title_bar .location {
      font-size: 22px;
      font-weight: 600;
    }
  </style>
</head>
<body class="environment trmnl">
  <div class="screen">
    <div class="view view--full">
      <div class="layout">
        <!-- Weather Icon -->
        <div class="weather-icon">{{ current_icon }}</div>

        <!-- Current Temperature -->
        <div class="current-temp">{{ current_temp }}°</div>

        <!-- Two Column Layout -->
        <div class="columns">
          <!-- Today -->
          <div class="column">
            <div class="condition-text">{{ current_condition }}</div>
            <div class="temp-text">L/H {{ temp_low }}° - {{ temp_high }}°</div>
            <div class="uv-text">UV Lav ({{ uv_index }})</div>
          </div>

          <!-- Tomorrow -->
          <div class="column">
            <div class="tomorrow-badge">I morgen</div>
            <div class="condition-text">{{ tomorrow_condition }}</div>
            <div class="temp-text">L/H {{ tomorrow_temp_low }}° - {{ tomorrow_temp_high }}°</div>
            <div class="uv-text">UV Lav ({{ tomorrow_uv_index }})</div>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div class="title_bar">
        <span class="time">{{ current_time }}</span>
        <span class="location">{{ location_name }}</span>
      </div>
    </div>
  </div>
</body>
</html>
